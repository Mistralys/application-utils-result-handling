{
    "name" : "mistralys/application-utils-result-handling",
    "description" : "Classes used to store information on the results of application operations.",
    "type" : "library",
    "license" : "MIT",
    "authors" : 
    [
        {
            "email" : "s.mordziol@mistralys.eu",
            "name" : "Sebastian Mordziol",
            "role" : "Lead"
        }
    ],
    "autoload" : 
    {
        "files": [
            "src/global-functions.php"
        ],
        "classmap" :
        [
            "src/"
        ]
    },
